<?xml version="1.0" encoding="UTF-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{7A1F3E10-4B2C-4E9A-9E1D-1A2B3C4D5E6F}</ProjectGuid>
        <ProjectVersion>20.4</ProjectVersion>
        <FrameworkType>None</FrameworkType>
        <MainSource>DelphiTwinTests.dpr</MainSource>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
        <TargetedPlatforms>1</TargetedPlatforms>
        <AppType>Console</AppType>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_DebugInformation>true</DCC_DebugInformation>
        <DCC_Optimize>false</DCC_Optimize>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_UnitSearchPath>..\src;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_Namespace>System.Win;Winapi;System.Win;Data.Win;Datasnap.Win;Web.Win;Soap.Win;Xml.Win;Bde;$(DCC_Namespace)</DCC_Namespace>
        <DCC_ExeOutput>bin</DCC_ExeOutput>
        <DCC_DcuOutput>dcu</DCC_DcuOutput>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="DelphiTwinTests.dpr">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="Tests.Helpers.pas"/>
        <DCCReference Include="Tests.Decimal.pas"/>
        <DCCReference Include="Tests.Icms.pas"/>
        <DCCReference Include="Tests.IcmsST.pas"/>
        <DCCReference Include="Tests.Ipi.pas"/>
        <DCCReference Include="Tests.PisCofins.pas"/>
        <DCCReference Include="Tests.Difal.pas"/>
        <DCCReference Include="Tests.Spec.pas"/>
        <DCCReference Include="..\src\Tributos.Types.pas"/>
        <DCCReference Include="..\src\Tributos.Decimal.pas"/>
        <DCCReference Include="..\src\Tributos.Icms.pas"/>
        <DCCReference Include="..\src\Tributos.IcmsST.pas"/>
        <DCCReference Include="..\src\Tributos.Ipi.pas"/>
        <DCCReference Include="..\src\Tributos.PisCofins.pas"/>
        <DCCReference Include="..\src\Tributos.Difal.pas"/>
        <DCCReference Include="..\src\Tributos.Motor.pas"/>
        <DCCReference Include="..\src\Tributos.SpecLoader.pas"/>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
    </ItemGroup>
    <Import Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')" Project="$(BDS)\Bin\CodeGear.Delphi.Targets"/>
    <Import Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATADIR)\$(PRODUCTVERSION)\UserTools.proj')" Project="$(APPDATA)\Embarcadero\$(BDSAPPDATADIR)\$(PRODUCTVERSION)\UserTools.proj"/>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">DelphiTwinTests.dpr</Source>
                </Source>
            </Delphi.Personality>
            <Platforms>
                <Platform value="Win32">True</Platform>
                <Platform value="Win64">False</Platform>
            </Platforms>
        </BorlandProject>
    </ProjectExtensions>
</Project>
